{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DaggerCraft Toolbox",
  "version": "1.0.1",
  "identifier": "com.daggercraft.toolbox",
  "build": {
    "beforeDevCommand": "npm run prepare:desktop",
    "beforeBuildCommand": "npm run prepare:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DaggerCraft Toolbox",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Fast, offline-first tools for tabletop DMs.",
    "longDescription": "DaggerCraft Toolbox is a fast collection of offline generators, encounter tools, monster utilities, and campaign-prep helpers for tabletop DMs.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
